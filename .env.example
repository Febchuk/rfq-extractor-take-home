# Gemini Developer API key. Do not also set GOOGLE_API_KEY:
# the Google SDK prefers GOOGLE_API_KEY when both are present.
GEMINI_API_KEY=

# TypeSafe key for Jev. The SDK defaults to the jev-latest model.
TYPESAFE_API_KEY=

# Optional overrides.
EXTRACTOR_MODEL=gemini-3.8-flash
EXTRACTOR_ESCALATION_MODEL=gemini-3.1-pro-preview
